      "cell_type": "code",
      "execution_count": 172,
      "metadata": {
        "id": "dataset_class"
      },
      "outputs": [],
      "source": [
        "# @title Dataset Class with Tag Support (Research Q4: Preprocessing)\n",
        "class StoryDataset(Dataset):\n",
        "    \"\"\"Story Reasoning dataset with semantic tag extraction.\"\"\"\n",
        "\n",
        "    def __init__(self, dataset, tokenizer, tag_to_idx, tag_vocab_size):\n",
        "        self.dataset = dataset\n",
        "        self.tokenizer = tokenizer\n",
        "        self.tag_to_idx = tag_to_idx\n",
        "        self.tag_vocab_size = tag_vocab_size\n",
        "        self.transform = transforms.Compose([\n",
        "            transforms.Resize((64, 128)),  # Preprocessing: resize to match VAE output\n",
        "            transforms.ToTensor()           # Normalize to [0,1]\n",
        "        ])\n",
        "\n",
        "    def __len__(self):\n",
        "        return len(self.dataset)\n",
        "\n",
        "    def __getitem__(self, idx):\n",
        "        item = self.dataset[idx]\n",
        "        num_frames = item[\"frame_count\"]\n",
        "        frames = item[\"images\"]\n",
        "        story_data = parse_gdi(item[\"story\"])\n",
        "\n",
        "        # Select 5 frames uniformly (temporal order preserved)\n",
        "        if num_frames > 5:\n",
        "            indices = torch.linspace(0, num_frames-1, 5).long()\n",
        "        else:\n",
        "            indices = torch.arange(min(5, num_frames))\n",
        "\n",
        "        frame_tensors, desc_tensors, tag_tensors = [], [], []\n",
        "\n",
        "        for i in indices:\n",
        "            # Frame processing\n",
        "            frame_tensors.append(self.transform(frames[i]))\n",
        "\n",
        "            if i < len(story_data):\n",
        "                desc = story_data[i]['description']\n",
        "\n",
        "                # Text tokenization\n",
        "                tokens = self.tokenizer(desc, return_tensors=\"pt\",\n",
        "                                       padding='max_length', truncation=True, max_length=64)\n",
        "                desc_tensors.append(tokens.input_ids.squeeze(0))\n",
        "\n",
        "                # Tag extraction (NEW: Semantic grounding)\n",
        "                tags = extract_tags(desc, self.tag_to_idx.keys())\n",
        "                tag_tensors.append(tags_to_multihot(tags, self.tag_to_idx, self.tag_vocab_size))\n",
        "            else:\n",
        "                desc_tensors.append(torch.zeros(64, dtype=torch.long))\n",
        "                tag_tensors.append(torch.zeros(self.tag_vocab_size))\n",
        "\n",
        "        # Input: first 4, Target: 5th\n",
        "        return (\n",
        "            torch.stack(frame_tensors[:4]),\n",
        "            torch.stack(desc_tensors[:4]),\n",
        "            torch.stack(tag_tensors[:4]),\n",
        "            frame_tensors[4] if len(frame_tensors) > 4 else frame_tensors[-1],\n",
        "            desc_tensors[4] if len(desc_tensors) > 4 else desc_tensors[-1]\n",
        "        )\n"
      ]
    },
