        "# @title Create Quantitative Results Table (Research Q5)\n",
        "# Calculate averages over last 5 epochs\n",
        "last_n = 5\n",
        "results_table = pd.DataFrame({\n",
        "    'Metric': ['Perplexity ↓', 'BLEU ↑', 'SSIM ↑', 'Image MSE ↓', 'Cross-Modal Sim ↑'],\n",
        "    'Baseline': [65.61, 0.0135, 0.155, 0.0777, -0.1845],\n",
        "    'LSTM + Tags (Ours)': [\n",
        "        np.mean(history['val_perplexity'][-last_n:]),\n",
        "        np.mean(history['val_bleu'][-last_n:]),\n",
        "        np.mean(history['val_ssim'][-last_n:]),\n",
        "        np.mean(history['val_img_mse'][-last_n:]),\n",
        "        np.mean(history['val_cross_modal'][-last_n:])\n",
        "    ]\n",
        "})\n",
        "\n",
        "# Calculate improvements\n",
        "results_table['Improvement'] = [\n",
        "    f\"{((results_table.iloc[0,1] - results_table.iloc[0,2]) / results_table.iloc[0,1] * 100):.1f}%\" if results_table.iloc[0,1] != 0 else \"N/A\",\n",
        "    f\"{((results_table.iloc[1,2] - results_table.iloc[1,1]) / results_table.iloc[1,1] * 100):.1f}%\" if results_table.iloc[1,1] != 0 else \"N/A\",\n",
        "    f\"{((results_table.iloc[2,2] - results_table.iloc[2,1]) / results_table.iloc[2,1] * 100):.1f}%\" if results_table.iloc[2,1] != 0 else \"N/A\",\n",
        "    f\"{((results_table.iloc[3,2] - results_table.iloc[3,1]) / results_table.iloc[3,1] * 100):.1f}%\" if results_table.iloc[3,1] != 0 else \"N/A\",\n",
        "    'Positive' if np.mean(history['val_cross_modal'][-last_n:]) > np.mean(history['val_cross_modal'][:5]) else 'Negative'\n",
        "]\n",
        "\n",
        "# Save to MineDNN/results/comparative/\n",
        "results_table.to_excel(f\"{DIRS['comparative']}/comparison_table.xlsx\", index=False)\n",
        "\n",
        "print('\\n' + '='*80)\n",
        "print('QUANTITATIVE RESULTS (Research Q5)')\n",
