      "source": [
        "# @title Training Loop - 25 Epochs (Research Q5: Results)\n",
        "print('='*80)\n",
        "print('TRAINING FOR 25 EPOCHS - TEXT QUALITY IMPROVEMENT FOCUS')\n",
        "print('='*80)\n",
        "\n",
        "history = {\n",
        "    'epoch': [],\n",
        "    # Text metrics (PRIMARY)\n",
        "    'train_perplexity': [], 'val_perplexity': [],\n",
        "    'train_bleu': [], 'val_bleu': [],\n",
        "    # Visual metrics (SECONDARY)\n",
        "    'train_img_mse': [], 'val_img_mse': [],\n",
        "    'train_ssim': [], 'val_ssim': [],\n",
        "    # Combined\n",
        "    'train_loss': [], 'val_loss': [],\n",
        "    'train_cross_modal': [], 'val_cross_modal': [],\n",
        "    'lr': []\n",
        "}\n",
        "\n",
        "best_val_loss = float('inf')\n",
        "best_perplexity = float('inf')\n",
        "\n",
        "for epoch in range(1, CONFIG['epochs'] + 1):\n",
        "    # TRAIN\n",
        "    model.train()\n",
        "    train_metrics = {'loss': 0, 'img_mse': 0, 'ssim': 0, 'ppl': 0, 'bleu': 0, 'cm': 0}\n",
        "\n",
        "    for batch_idx, (frames, descs, tags, tgt_frame, tgt_desc) in enumerate(train_loader):\n",
        "        frames, descs, tags = frames.to(device), descs.to(device), tags.to(device)\n",
        "        tgt_frame, tgt_desc = tgt_frame.to(device), tgt_desc.to(device)\n",
        "\n",
        "        optimizer.zero_grad()\n",
        "\n",
        "        pred_img, pred_ctx, pred_text, attn, img_feats = model(frames, descs, tags, tgt_desc)\n",
        "\n",
        "        # Losses\n",
        "        loss_img = criterion_img(pred_img, tgt_frame)\n",
        "        loss_ctx = criterion_ctx(pred_ctx, tgt_frame)\n",
        "        loss_text = criterion_text(pred_text.reshape(-1, pred_text.size(-1)),\n",
        "                                    tgt_desc.reshape(-1))\n",
        "\n",
        "        # Weighted loss (emphasize text quality)\n",
        "        loss = loss_img + 0.5 * loss_ctx + 0.5 * loss_text  # Text has higher weight\n",
        "\n",
        "        loss.backward()\n",
        "        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n",
        "        optimizer.step()\n",
        "\n",
        "        # Metrics\n",
        "        with torch.no_grad():\n",
        "            train_metrics['loss'] += loss.item()\n",
        "            train_metrics['img_mse'] += F.mse_loss(pred_img, tgt_frame).item()\n",
        "            train_metrics['ssim'] += compute_ssim(pred_img[0], tgt_frame[0])\n",
        "            train_metrics['ppl'] += torch.exp(loss_text).item()\n",
        "            train_metrics['bleu'] += compute_bleu(pred_text[0].argmax(-1), tgt_desc[0], tokenizer)\n",
        "\n",
        "            _, h_t, _ = model.text_enc(tgt_desc)\n",
        "            train_metrics['cm'] += compute_cross_modal_sim(img_feats, h_t[-1])\n",
        "\n",
        "    # Average train metrics\n",
        "    for k in train_metrics:\n",
        "        train_metrics[k] /= len(train_loader)\n",
        "\n",
        "    # VALIDATION\n",
        "    model.eval()\n",
        "    val_metrics = {'loss': 0, 'img_mse': 0, 'ssim': 0, 'ppl': 0, 'bleu': 0, 'cm': 0}\n",
        "\n",
        "    with torch.no_grad():\n",
        "        for frames, descs, tags, tgt_frame, tgt_desc in val_loader:\n",
        "            frames, descs, tags = frames.to(device), descs.to(device), tags.to(device)\n",
        "            tgt_frame, tgt_desc = tgt_frame.to(device), tgt_desc.to(device)\n",
        "\n",
        "            pred_img, pred_ctx, pred_text, attn, img_feats = model(frames, descs, tags, tgt_desc)\n",
        "\n",
        "            loss_img = criterion_img(pred_img, tgt_frame)\n",
        "            loss_ctx = criterion_ctx(pred_ctx, tgt_frame)\n",
        "            loss_text = criterion_text(pred_text.reshape(-1, pred_text.size(-1)),\n",
        "                                        tgt_desc.reshape(-1))\n",
        "\n",
        "            loss = loss_img + 0.5 * loss_ctx + 0.5 * loss_text\n",
        "\n",
        "            val_metrics['loss'] += loss.item()\n",
        "            val_metrics['img_mse'] += F.mse_loss(pred_img, tgt_frame).item()\n",
        "            val_metrics['ssim'] += compute_ssim(pred_img[0], tgt_frame[0])\n",
        "            val_metrics['ppl'] += torch.exp(loss_text).item()\n",
        "            val_metrics['bleu'] += compute_bleu(pred_text[0].argmax(-1), tgt_desc[0], tokenizer)\n",
        "\n",
        "            _, h_t, _ = model.text_enc(tgt_desc)\n",
        "            val_metrics['cm'] += compute_cross_modal_sim(img_feats, h_t[-1])\n",
        "\n",
        "    # Average val metrics\n",
        "    for k in val_metrics:\n",
        "        val_metrics[k] /= len(val_loader)\n",
        "\n",
        "    # Scheduler\n",
        "    scheduler.step(val_metrics['ppl'])  # Focus on text quality\n",
        "    lr = optimizer.param_groups[0]['lr']\n",
        "\n",
        "    # Save history\n",
        "    history['epoch'].append(epoch)\n",
        "    history['train_loss'].append(train_metrics['loss'])\n",
        "    history['train_img_mse'].append(train_metrics['img_mse'])\n",
        "    history['train_ssim'].append(train_metrics['ssim'])\n",
        "    history['train_perplexity'].append(train_metrics['ppl'])\n",
        "    history['train_bleu'].append(train_metrics['bleu'])\n",
        "    history['train_cross_modal'].append(train_metrics['cm'])\n",
        "\n",
        "    history['val_loss'].append(val_metrics['loss'])\n",
        "    history['val_img_mse'].append(val_metrics['img_mse'])\n",
        "    history['val_ssim'].append(val_metrics['ssim'])\n",
        "    history['val_perplexity'].append(val_metrics['ppl'])\n",
        "    history['val_bleu'].append(val_metrics['bleu'])\n",
        "    history['val_cross_modal'].append(val_metrics['cm'])\n",
        "    history['lr'].append(lr)\n",
        "\n",
        "    # Print (emphasize text metrics)\n",
        "    print(f'\\nEpoch {epoch}/{CONFIG[\"epochs\"]}')\n",
        "    print(f'TEXT - Train PPL: {train_metrics[\"ppl\"]:.2f}, BLEU: {train_metrics[\"bleu\"]:.4f}')\n",
        "    print(f'           Val   PPL: {val_metrics[\"ppl\"]:.2f}, BLEU: {val_metrics[\"bleu\"]:.4f}')\n",
        "    print(f'IMG  - Train MSE: {train_metrics[\"img_mse\"]:.4f}, SSIM: {train_metrics[\"ssim\"]:.3f}')\n",
        "    print(f'           Val   MSE: {val_metrics[\"img_mse\"]:.4f}, SSIM: {val_metrics[\"ssim\"]:.3f}')\n",
        "\n",
        "    # Save best based on text quality\n",
        "    if val_metrics['ppl'] < best_perplexity:\n",
        "        best_perplexity = val_metrics['ppl']\n",
        "        save_checkpoint(model, optimizer, epoch, val_metrics, 'best_model_text.pth')\n",
        "        print(f'Best TEXT model (PPL: {best_perplexity:.2f})')\n",
        "\n",
        "    if val_metrics['loss'] < best_val_loss:\n",
        "        best_val_loss = val_metrics['loss']\n",
        "        save_checkpoint(model, optimizer, epoch, val_metrics, 'best_model_overall.pth')\n",
        "\n",
        "    if epoch % 5 == 0:\n",
        "        save_checkpoint(model, optimizer, epoch, val_metrics, f'checkpoint_epoch_{epoch}.pth')\n",
        "\n",
        "print('\\n' + '='*80)\n",
        "print('TRAINING COMPLETE!')\n",
        "print(f'Best Perplexity (Text Quality): {best_perplexity:.2f}')\n",
        "print(f'Best Overall Loss: {best_val_loss:.4f}')\n",
        "print('='*80)\n"
      ]
    },
