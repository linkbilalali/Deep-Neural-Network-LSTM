      "metadata": {
        "id": "text_models"
      },
      "outputs": [],
      "source": [
        "# @title Text Autoencoder (Baseline Component)\n",
        "class TextEncoder(nn.Module):\n",
        "    def __init__(self, vocab_size, emb_dim, hidden_dim, n_layers=1, dropout=0.1):\n",
        "        super().__init__()\n",
        "        self.embed = nn.Embedding(vocab_size, emb_dim)\n",
        "        self.lstm = nn.LSTM(emb_dim, hidden_dim, n_layers, batch_first=True,\n",
        "                           dropout=dropout if n_layers > 1 else 0)\n",
        "\n",
        "    def forward(self, x):\n",
        "        x = self.embed(x)\n",
        "        out, (h, c) = self.lstm(x)\n",
        "        return out, h, c\n",
        "\n",
        "class TextDecoder(nn.Module):\n",
        "    def __init__(self, vocab_size, emb_dim, hidden_dim, n_layers=1, dropout=0.1):\n",
        "        super().__init__()\n",
        "        self.embed = nn.Embedding(vocab_size, emb_dim)\n",
        "        self.lstm = nn.LSTM(emb_dim, hidden_dim, n_layers, batch_first=True,\n",
        "                           dropout=dropout if n_layers > 1 else 0)\n",
        "        self.fc = nn.Linear(hidden_dim, vocab_size)\n",
        "\n",
        "    def forward(self, x, h, c):\n",
        "        x = self.embed(x)\n",
        "        out, (h, c) = self.lstm(x, (h, c))\n",
        "        return self.fc(out), h, c\n",
        "\n",
        "class TextAutoencoder(nn.Module):\n",
        "    def __init__(self, encoder, decoder):\n",
        "        super().__init__()\n",
        "        self.encoder = encoder\n",
        "        self.decoder = decoder\n",
        "\n",
        "    def forward(self, src, tgt):\n",
        "        _, h, c = self.encoder(src)\n",
        "        logits, _, _ = self.decoder(tgt, h, c)\n",
        "        return logits"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 174,
      "metadata": {
        "id": "visual_models"
      },
      "outputs": [],
      "source": [
        "# @title Visual Autoencoder (Baseline Component)\n",
        "class VisionBackbone(nn.Module):\n",
        "    def __init__(self, latent_dim=16, out_h=8, out_w=16):\n",
        "        super().__init__()\n",
        "        self.encoder = nn.Sequential(\n",
        "            nn.Conv2d(3, 16, 7, 2, 3), nn.GroupNorm(8, 16), nn.LeakyReLU(0.1),\n",
        "            nn.Conv2d(16, 32, 5, 2, 2), nn.GroupNorm(8, 32), nn.LeakyReLU(0.1),\n",
        "            nn.Conv2d(32, 64, 3, 2, 1), nn.GroupNorm(8, 64), nn.LeakyReLU(0.1)\n",
        "        )\n",
        "        self.flat_dim = 64 * out_h * out_w\n",
        "        self.enc_fc = nn.Linear(self.flat_dim, latent_dim)\n",
        "        self.dec_fc = nn.Linear(latent_dim, self.flat_dim)\n",
        "        self.decoder = nn.Sequential(\n",
        "            nn.ConvTranspose2d(64, 32, 3, 2, 1, 1), nn.GroupNorm(8, 32), nn.LeakyReLU(0.1),\n",
        "            nn.ConvTranspose2d(32, 16, 5, 2, 2, 1), nn.GroupNorm(8, 16), nn.LeakyReLU(0.1),\n",
        "            nn.ConvTranspose2d(16, 3, 7, 2, 3, 1), nn.Sigmoid()\n",
        "        )\n",
        "        self.out_h, self.out_w = out_h, out_w\n",
        "\n",
        "    def encode(self, x):\n",
        "        x = self.encoder(x)\n",
        "        return self.enc_fc(x.view(x.size(0), -1))\n",
        "\n",
        "    def decode(self, z):\n",
        "        x = self.dec_fc(z).view(z.size(0), 64, self.out_h, self.out_w)\n",
        "        return self.decoder(x)\n",
        "\n",
        "class VisualAutoencoder(nn.Module):\n",
        "    def __init__(self, latent_dim=16):\n",
        "        super().__init__()\n",
        "        self.backbone = VisionBackbone(latent_dim)\n",
        "        self.encoder = self.backbone\n",
        "        self.decoder = self.backbone\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.decoder.decode(self.encoder.encode(x))"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 175,
      "metadata": {
        "id": "tag_embedder"
      },
      "outputs": [],
      "source": [
        "# @title Tag Embedding Module (NEW - Research Q2)\n",
        "class TagEmbedder(nn.Module):\n",
        "    \"\"\"\n",
        "    Semantic Tag Embedder (NEW COMPONENT)\n",
        "    Converts multi-hot tag vectors → dense semantic embeddings\n",
        "    Provides explicit grounding in objects, actions, locations\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, tag_vocab_size, embed_dim=16):\n",
        "        super().__init__()\n",
        "        self.net = nn.Sequential(\n",
        "            nn.Linear(tag_vocab_size, 32),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.1),\n",
        "            nn.Linear(32, embed_dim)\n",
        "        )\n",
        "\n",
        "    def forward(self, tag_vec):\n",
        "        \"\"\"tag_vec: [B, tag_vocab_size] → [B, embed_dim]\"\"\"\n",
        "        return self.net(tag_vec)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 176,
      "metadata": {
        "id": "attention"
      },
      "outputs": [],
      "source": [
        "# @title Attention Mechanism\n",
        "class Attention(nn.Module):\n",
        "    def __init__(self, hidden_dim):\n",
        "        super().__init__()\n",
        "        self.attn = nn.Linear(hidden_dim, 1)\n",
        "\n",
        "    def forward(self, seq):\n",
        "        \"\"\"seq: [B, T, H] → context: [B, H], weights: [B, T]\"\"\"\n",
        "        scores = self.attn(seq).squeeze(-1)\n",
        "        weights = F.softmax(scores, dim=1)\n",
        "        context = torch.bmm(weights.unsqueeze(1), seq).squeeze(1)\n",
        "        return context, weights"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 177,
      "metadata": {
        "id": "main_model"
      },
      "outputs": [],
      "source": [
        "# @title Enhanced Sequence Predictor (MAIN MODEL - Research Q2)\n",
        "class EnhancedPredictor(nn.Module):\n",
        "    \"\"\"\n",
        "    Enhanced Story Reasoning Model with:\n",
        "    1. 2-Layer LSTM (NEW) - Better temporal modeling vs single GRU\n",
        "    2. Tag Embeddings (NEW) - Semantic grounding\n",
        "    3. Enhanced Fusion - Visual(16D) + Text(16D) + Tags(16D) = 48D\n",
        "\n",
        "    Focus: Improve TEXT DESCRIPTION QUALITY\n",
        "    \"\"\"\n",
        "\n",
        "    def __init__(self, vis_ae, text_ae, tag_embedder, latent_dim, lstm_hidden):\n",
        "        super().__init__()\n",
        "\n",
        "        # Encoders\n",
        "        self.vis_enc = vis_ae.encoder\n",
        "        self.text_enc = text_ae.encoder\n",
        "        self.tag_emb = tag_embedder\n",
        "\n",
        "        # 2-LAYER LSTM for temporal modeling (NEW)\n",
        "        # Rationale: Better sequence structure capture (Hochreiter & Schmidhuber, 1997)\n",
        "        fusion_dim = latent_dim * 2 + tag_embedder.net[-1].out_features  # Corrected fusion_dim\n",
        "        self.lstm = nn.LSTM(fusion_dim, lstm_hidden, num_layers=2,\n",
        "                           batch_first=True, dropout=0.2)\n",
        "\n",
        "        # Attention\n",
        "        self.attn = Attention(lstm_hidden)\n",
        "\n",
        "        # Prediction heads\n",
        "        self.img_head = nn.Sequential(\n",
        "            nn.Linear(lstm_hidden, latent_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.2)\n",
        "        )\n",
        "\n",
        "        self.ctx_head = nn.Sequential(\n",
        "            nn.Linear(lstm_hidden * 2, latent_dim),\n",
        "            nn.ReLU(),\n",
        "            nn.Dropout(0.2)\n",
        "        )\n",
        "\n",
        "        # Decoders\n",
        "        self.vis_dec = vis_ae.decoder\n",
        "        self.text_dec = text_ae.decoder\n",
        "\n",
        "        # Projection layers to match LSTM output to TextDecoder input\n",
        "        # TextDecoder expects (num_layers, B, latent_dim) based on its initialization\n",
        "        # self.lstm outputs (num_layers, B, lstm_hidden)\n",
        "        # Since CONFIG['n_layers'] == text_ae.decoder.lstm.num_layers and latent_dim == lstm_hidden\n",
        "        # the direct h, c from self.lstm should match, so no projection is strictly needed IF passed correctly.\n",
        "        # However, if latent_dim != lstm_hidden, then projection is needed for each layer.\n",
        "        if lstm_hidden != latent_dim or self.lstm.num_layers != text_ae.decoder.lstm.num_layers:\n",
        "            # This case implies projection is needed. For multi-layer LSTM, we'd need to project each layer.\n",
        "            # For simplicity and given current config (latent_dim == lstm_hidden, num_layers match),\n",
        "            # this path won't be taken. If it were, proper multi-layer projection would be more complex.\n",
        "            self.text_dec_h_proj = nn.Linear(lstm_hidden, latent_dim) # This will project only if called on individual layers\n",
        "            self.text_dec_c_proj = nn.Linear(lstm_hidden, latent_dim)\n",
        "        else:\n",
        "            self.text_dec_h_proj = None\n",
        "            self.text_dec_c_proj = None\n",
        "\n",
        "    def forward(self, frames, descs, tags, tgt_desc):\n",
        "        \"\"\"\n",
        "        Args:\n",
        "            frames: [B, 4, 3, H, W]\n",
        "            descs: [B, 4, seq_len]\n",
        "            tags: [B, 4, tag_vocab_size]\n",
        "            tgt_desc: [B, seq_len]\n",
        "        Returns:\n",
        "            pred_img, pred_img_ctx, pred_text, attn_weights, img_features\n",
        "        \"\"\"\n",
        "        B, T = frames.shape[:2]\n",
        "\n",
        "        # Encode each timestep\n",
        "        fused_seq = []\n",
        "        for t in range(T):\n",
        "            z_v = self.vis_enc.encode(frames[:, t])\n",
        "            _, h_t, _ = self.text_enc(descs[:, t])\n",
        "            z_t = h_t[-1] # Take the last layer's hidden state for text encoding\n",
        "            z_tag = self.tag_emb(tags[:, t])  # NEW: Tag embedding\n",
        "            fused_seq.append(torch.cat([z_v, z_t, z_tag], dim=1))  # 48D fusion\n",
        "\n",
        "        fused_seq = torch.stack(fused_seq, dim=1)  # [B, T, 48]\n",
        "\n",
        "        # 2-Layer LSTM temporal modeling (NEW)\n",
        "        lstm_out, (h, c) = self.lstm(fused_seq) # h, c are (num_layers, B, lstm_hidden) = (2, B, 64)\n",
        "\n",
        "        # Attention over sequence\n",
        "        context, attn_w = self.attn(lstm_out)\n",
        "        final_h = h[-1] # Hidden state of the last layer of the main LSTM for image prediction\n",
        "\n",
        "        # Prepare hidden and cell states for the TextDecoder\n",
        "        # Pass h and c directly, as their dimensions (2, B, 64) match TextDecoder's expectations.\n",
        "        dec_h = h\n",
        "        dec_c = c\n",
        "\n",
        "        if self.text_dec_h_proj and self.text_dec_c_proj:\n",
        "            # This block would only be entered if latent_dim != lstm_hidden or num_layers mismatched initially.\n",
        "            # Given the current CONFIG, this block will not be executed as proj objects are None.\n",
        "            # If it were, projecting (num_layers, B, lstm_hidden) with nn.Linear needs care (e.g., reshape or apply layer-wise).\n",
        "            pass # dec_h and dec_c are already in the correct format for the TextDecoder's LSTM\n",
        "\n",
        "        # Predict image (content)\n",
        "        z_img = self.img_head(final_h)\n",
        "        pred_img = self.vis_dec.decode(z_img)\n",
        "\n",
        "        # Predict image (context-aware)\n",
        "        z_ctx = self.ctx_head(torch.cat([final_h, context], dim=1))\n",
        "        pred_img_ctx = self.vis_dec.decode(z_ctx)\n",
        "\n",
        "        # Predict text (PRIMARY FOCUS) using the adjusted hidden states\n",
        "        pred_text, _, _ = self.text_dec(tgt_desc, dec_h, dec_c)\n",
        "\n",
        "        return pred_img, pred_img_ctx, pred_text, attn_w, z_img\n"
      ]
    },
