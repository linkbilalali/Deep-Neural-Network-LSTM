        "# @title Evaluation Metrics (Research Q3)\n",
        "def compute_ssim(img1, img2):\n",
        "    \"\"\"Structural Similarity Index.\"\"\"\n",
        "    img1_np = img1.cpu().permute(1, 2, 0).numpy()\n",
        "    img2_np = img2.cpu().permute(1, 2, 0).numpy()\n",
        "    return ssim_metric(img1_np, img2_np, multichannel=True,\n",
        "                      channel_axis=2, data_range=1.0)\n",
        "\n",
        "def compute_bleu(pred_tokens, target_tokens, tokenizer):\n",
        "    \"\"\"BLEU score for text quality.\"\"\"\n",
        "    pred_text = tokenizer.decode(pred_tokens, skip_special_tokens=True).split()\n",
        "    target_text = tokenizer.decode(target_tokens, skip_special_tokens=True).split()\n",
        "    if len(pred_text) == 0 or len(target_text) == 0:\n",
        "        return 0.0\n",
        "    return sentence_bleu([target_text], pred_text,\n",
        "                         smoothing_function=SmoothingFunction().method1)\n",
        "\n",
        "def compute_cross_modal_sim(img_feats, text_feats):\n",
        "    \"\"\"Cross-modal alignment similarity.\"\"\"\n",
        "    img_norm = F.normalize(img_feats, p=2, dim=1)\n",
        "    text_norm = F.normalize(text_feats, p=2, dim=1)\n",
        "    return (img_norm * text_norm).sum(dim=1).mean().item()"
      ]
    },
