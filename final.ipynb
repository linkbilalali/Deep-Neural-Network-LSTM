      ],
      "source": [
        "# @title Create Tag Vocabulary (84 tags)\n",
        "def create_tag_vocabulary():\n",
        "    \"\"\"Create semantic tag vocabulary: Objects, Actions, Locations\"\"\"\n",
        "\n",
        "    OBJECTS = ['person', 'man', 'woman', 'child', 'boy', 'girl', 'dog', 'cat',\n",
        "               'car', 'bike', 'tree', 'house', 'phone', 'computer', 'book',\n",
        "               'ball', 'chair', 'table', 'door', 'window', 'food', 'drink',\n",
        "               'bag', 'box', 'flower', 'animal', 'bird', 'fish']\n",
        "\n",
        "    ACTIONS = ['running', 'walking', 'sitting', 'standing', 'cooking', 'eating',\n",
        "               'drinking', 'playing', 'reading', 'writing', 'talking', 'sleeping',\n",
        "               'jumping', 'dancing', 'working', 'driving', 'picking', 'holding',\n",
        "               'looking', 'smiling', 'crying', 'laughing', 'thinking', 'pointing',\n",
        "               'opening', 'closing', 'giving', 'taking', 'watching', 'listening']\n",
        "\n",
        "    LOCATIONS = ['street', 'park', 'kitchen', 'bedroom', 'office', 'school',\n",
        "                 'store', 'restaurant', 'beach', 'forest', 'mountain', 'city',\n",
        "                 'home', 'garden', 'room', 'building', 'outside', 'inside',\n",
        "                 'hospital', 'library', 'field', 'road', 'sidewalk', 'yard',\n",
        "                 'house', 'sky']\n",
        "\n",
        "    all_tags = OBJECTS + ACTIONS + LOCATIONS\n",
        "    tag_to_idx = {tag: i for i, tag in enumerate(all_tags)}\n",
        "\n",
        "    # Save vocabulary to MineDNN/data/\n",
        "    vocab_info = {\n",
        "        'objects': OBJECTS,\n",
        "        'actions': ACTIONS,\n",
        "        'locations': LOCATIONS,\n",
        "        'total': len(all_tags),\n",
        "        'created_at': datetime.now().isoformat()\n",
        "    }\n",
        "\n",
        "    with open(f\"{DIRS['data']}/tag_vocabulary.json\", 'w') as f:\n",
        "        json.dump(vocab_info, f, indent=2)\n",
        "\n",
        "    print(f'Tag Vocabulary Created:')\n",
        "    print(f'   Objects: {len(OBJECTS)}')\n",
        "    print(f'   Actions: {len(ACTIONS)}')\n",
        "    print(f'   Locations: {len(LOCATIONS)}')\n",
        "    print(f'   Total: {len(all_tags)}')\n",
        "    print(f'   Saved to: MineDNN/data/tag_vocabulary.json')\n",
        "\n",
        "    return tag_to_idx, len(all_tags)\n",
        "\n",
        "def extract_tags(text, vocab_keys):\n",
        "    \"\"\"Extract tags from text description.\"\"\"\n",
        "    text_lower = text.lower()\n",
        "    return [tag for tag in vocab_keys if tag in text_lower]\n",
        "\n",
        "def tags_to_multihot(tags, tag_to_idx, vocab_size):\n",
        "    \"\"\"Convert tag list to multi-hot vector.\"\"\"\n",
        "    vec = torch.zeros(vocab_size)\n",
        "    for tag in tags:\n",
        "        if tag in tag_to_idx:\n",
        "            vec[tag_to_idx[tag]] = 1.0\n",
        "    return vec\n",
        "\n",
        "TAG_TO_IDX, TAG_VOCAB_SIZE = create_tag_vocabulary()"
      ]
    },
