      "source": [
        "# @title Data Parsing Utilities\n",
        "def parse_gdi(text):\n",
        "    \"\"\"Parse GDI-formatted story text.\"\"\"\n",
        "    soup = BeautifulSoup(text, 'html.parser')\n",
        "    items = []\n",
        "    for gdi in soup.find_all('gdi'):\n",
        "        img_id = None\n",
        "        for attr in gdi.attrs:\n",
        "            if 'image' in attr.lower():\n",
        "                img_id = attr.replace('image', '')\n",
        "                break\n",
        "        if not img_id:\n",
        "            match = re.search(r'\\\\d+', str(gdi.attrs))\n",
        "            if match:\n",
        "                img_id = match.group()\n",
        "        if img_id:\n",
        "            try:\n",
        "                items.append({\n",
        "                    'image_id': int(img_id),\n",
        "                    'description': gdi.get_text(strip=True)\n",
        "                })\n",
        "            except:\n",
        "                pass\n",
        "    return sorted(items, key=lambda x: x['image_id'])"
      ]
    },
