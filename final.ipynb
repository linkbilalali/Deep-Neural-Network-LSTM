        "\n",
        "for i in range(min(4, frames.size(0))):\n",
        "    # Input frames\n",
        "    for j in range(4):\n",
        "        axes[i, j].imshow(frames[i, j].cpu().permute(1, 2, 0).numpy())\n",
        "        axes[i, j].set_title(f'Frame {j+1}', fontsize=9)\n",
        "        axes[i, j].axis('off')\n",
        "\n",
        "    # Ground truth\n",
        "    axes[i, 4].imshow(tgt_frame[i].cpu().permute(1, 2, 0).numpy())\n",
        "    axes[i, 4].set_title('Ground Truth', fontsize=9, color='green', fontweight='bold')\n",
        "    axes[i, 4].axis('off')\n",
        "\n",
        "    # Prediction\n",
        "    axes[i, 5].imshow(pred_img[i].cpu().permute(1, 2, 0).numpy())\n",
